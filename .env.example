# Banco de Dados (PostgreSQL no Vercel Postgres / Neon)
DATABASE_URL="postgresql://usuario:senha@host-pooler:5432/conversa_apoiada?sslmode=require"
# Conexão direta (sem pooler), usada pelo Prisma nas migrações
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/conversa_apoiada?sslmode=require"

# Vercel Blob privado (na Vercel vem sozinho; fora dela, use um token de leitura e escrita)
BLOB_READ_WRITE_TOKEN=""

# Código secreto da equipe para gerar novos links de convite para famílias
CODIGO_ACESSO="seu_codigo_secreto_aqui"

# URL pública da aplicação (ex: http://localhost:3000 em dev ou https://seu-app.vercel.app em prod)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
